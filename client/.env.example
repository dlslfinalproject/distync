# DISTYNC frontend access mode is required.
# Use exact uppercase values only.
# Allowed values: DEVELOPMENT or DEMO.
# DEVELOPMENT enables local development access.
# DEMO enables the official-facing demo access flow with normal RBAC.
# Official production deployments also use DEMO.
# DEMO builds require an absolute, non-loopback API URL and a Google client ID.
# Dedicated build commands set or assert the intended build mode for you:
# npm run build:development
# npm run build:demo
# Switching between DEVELOPMENT and DEMO signs the browser out and uses
# separate local browser storage for each mode.
# No fallback exists.
VITE_ACCESS_MODE=DEVELOPMENT

# Only VITE_-prefixed values are exposed to browser code. Never add database,
# JWT, Supabase service-role, or other server secrets to this file.

# Set the Google client ID for demo staff login.
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Set the frontend API base URL. DEMO builds require an absolute, non-loopback
# value; local development can use the localhost fallback when omitted.
VITE_API_BASE_URL=http://localhost:5000

# Optional public app URL used when generating user-facing QR links. Configure
# the deployed public origin for DEMO/production.
VITE_PUBLIC_APP_URL=http://localhost:5173

# Optional browser-visible Supabase adapter settings. Use only public project
# configuration here; never place a service-role key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
