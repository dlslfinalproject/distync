# DISTYNC backend access mode is required.
# Use exact uppercase values only.
# Allowed values: DEVELOPMENT or DEMO.
# Official-facing demo and production deployments should use DEMO.
# No fallback exists.
SERVER_ACCESS_MODE=DEVELOPMENT

# Development authentication bypass defaults to false when missing.
# It only works when SERVER_ACCESS_MODE=DEVELOPMENT.
# Invalid values stay disabled.
# Frontend demo builds should be paired with SERVER_ACCESS_MODE=DEMO and
# ENABLE_DEVELOPMENT_AUTH_BYPASS=false.
ENABLE_DEVELOPMENT_AUTH_BYPASS=false

# Server runtime configuration.
PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/distync
# Integration tests use this dedicated database only. Its database name must
# include "test" and test runs also require ALLOW_TEST_DB_MUTATIONS=true.
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/distync_test
ALLOW_TEST_DB_MUTATIONS=false
GOOGLE_CLIENT_ID=your-google-client-id
ANALYTICS_SERVICE_URL=http://localhost:8000
# Optional Resend notification-email delivery. Set only in an approved environment.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=DISTYNC
EMAIL_NOTIFICATION_MAX_ATTEMPTS=3
EMAIL_NOTIFICATION_RETRY_BASE_SECONDS=900
# Used only by an explicit, opt-in controlled verification command; never runtime delivery.
TEST_NOTIFICATION_EMAIL_RECIPIENT=
