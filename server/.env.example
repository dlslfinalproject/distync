# DISTYNC backend access mode is required.
# Use exact uppercase values only.
# Allowed values: DEVELOPMENT or DEMO.
# Official-facing demo and production deployments should use DEMO.
# No fallback exists.
SERVER_ACCESS_MODE=DEVELOPMENT

# Development authentication bypass defaults to false when missing.
# It only works when SERVER_ACCESS_MODE=DEVELOPMENT.
# Invalid values stay disabled.
# Frontend demo builds should be paired with SERVER_ACCESS_MODE=DEMO and
# ENABLE_DEVELOPMENT_AUTH_BYPASS=false.
ENABLE_DEVELOPMENT_AUTH_BYPASS=false

# Server runtime configuration.
PORT=5000
DATABASE_URL=
# Deployed server environments must set the exact frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Integration tests use this dedicated database only. Its database name must
# include "test" and test runs also require ALLOW_TEST_DB_MUTATIONS=true.
TEST_DATABASE_URL=
ALLOW_TEST_DB_MUTATIONS=false
# Optional setting read by manual database scripts. The normal API pool infers
# its TLS behavior from the database connection configuration.
DATABASE_SSL=
GOOGLE_CLIENT_ID=your-google-client-id
JWT_SECRET=replace-with-strong-random-server-secret
# Required for server-issued offline inventory stock-state basis tokens.
# Use a strong random secret and keep it server-only.
INVENTORY_STATE_BASIS_SECRET=replace-with-strong-random-server-secret
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_TIMEOUT_MS=15000
# Supabase Storage is server-owned for profile pictures.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
PROFILE_PICTURE_STORAGE_BUCKET=distync-profile-pictures
# Optional background worker tuning.
# Set false for controlled deployment smoke tests against a prepared baseline
# when startup must not insert/update notification policies or close events.
ENABLE_STARTUP_MAINTENANCE=true
# Optional inventory batch-status maintenance; disabled unless explicitly true.
ENABLE_INVENTORY_BATCH_STATUS_MAINTENANCE=false
NOTIFICATION_SCAN_INTERVAL_MS=900000
NOTIFICATION_OUTBOX_BATCH_SIZE=25
INVENTORY_DOMAIN_EFFECT_BATCH_SIZE=25
INVENTORY_DOMAIN_EFFECT_SCAN_INTERVAL_MS=900000
# Optional inventory item lookup override.
OPEN_FOOD_FACTS_API_BASE_URL=https://world.openfoodfacts.org
# Optional public donation contact/location text. Replace these safe examples
# with approved public-facing content in the deployment environment.
PUBLIC_DONATION_LOCATION_NAME=Example Municipal Hall
PUBLIC_DONATION_ADDRESS_LINE_1=Example address line 1
PUBLIC_DONATION_ADDRESS_LINE_2=Example address line 2
PUBLIC_DONATION_OFFICE_LINE_1=Example social welfare office
PUBLIC_DONATION_OFFICE_LINE_2=Example municipal government
PUBLIC_DONATION_RECEIVING_DAYS=Example receiving days
PUBLIC_DONATION_RECEIVING_TIME=Example receiving hours
PUBLIC_DONATION_PHONE=+00 000 000 0000
PUBLIC_DONATION_EMAIL=
PUBLIC_DONATION_MAPS_URL=https://example.com/maps
# Optional Resend notification-email delivery. Set only in an approved environment.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=DISTYNC
EMAIL_NOTIFICATION_MAX_ATTEMPTS=3
EMAIL_NOTIFICATION_RETRY_BASE_SECONDS=900
# Used only by an explicit, opt-in controlled verification command; never runtime delivery.
TEST_NOTIFICATION_EMAIL_RECIPIENT=
